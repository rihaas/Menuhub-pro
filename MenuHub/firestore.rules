rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMenuAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'admin.test@gmail.com';
    }

    match /menuItems/{itemId} {
      // Customers can read the public menu; only the allowlisted owner can change it.
      allow read: if true;
      allow create, update, delete: if isMenuAdmin();
    }

    // Deny all other database access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}